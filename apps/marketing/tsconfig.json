{
  "extends": "@biume/config/tsconfig/next",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*", "../../*"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/components/ai",
    "src/components/ai-elements",
    "src/components/dashboard",
    "src/components/onboarding",
    "src/components/reports-module",
    "src/components/subscription",
    "src/hooks/useAppContext.ts",
    "src/lib/api",
    "src/lib/auth",
    "src/lib/mastra",
    "src/lib/schemas",
    "src/lib/trigger",
    "src/lib/uploadthing"
  ]
}
